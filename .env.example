# OpenAI-compatible LLM service. Process-level WILLY_LLM_* values override
# this file. DeepSeek remains the default endpoint/model for legacy installs.
WILLY_LLM_API_KEY=your_api_key_here
WILLY_LLM_BASE_URL=https://api.deepseek.com
WILLY_LLM_MODEL=deepseek-v4-pro

# Legacy fallback only. Prefer the three WILLY_LLM_* values above for new setup.
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional external software overrides. Process-level WILLY_* values take
# precedence over this file, then PATH discovery or the documented legacy names.
# WILLY_G16_BIN=/path/to/g16
# WILLY_FORMCHK_BIN=/path/to/formchk
# WILLY_ORCA_HOME=/path/to/orca
# WILLY_ORCA_BIN=/path/to/orca/orca
# WILLY_ORCA_2MKL_BIN=/path/to/orca/orca_2mkl
# WILLY_MULTIWFN_BIN=/path/to/Multiwfn
# WILLY_GMX_BIN=/path/to/gmx
# WILLY_LIGPARGEN_BIN=/path/to/LigParGen
# WILLY_BOSS_HOME=/path/to/boss

# Legacy names remain supported during migration: ORCA_DIR, MULTIWFN_BIN, BOSSdir.
# When neither BOSS location is set, Willy uses ~/boss/boss if it exists.
