define =
integrator = md

dt         = 0.001
nsteps     = 10000000
comm-grps  = system
energygrps =
;
nstxout = 0
nstvout = 0
nstfout = 0
nstlog  = 500
nstenergy = 500
nstxout-compressed = 1000
compressed-x-grps  = system
;
pbc = xyz
cutoff-scheme = Verlet
coulombtype   = PME
rcoulomb      = 1.0
vdwtype       = Cut-off
rvdw          = 1.0
DispCorr      = EnerPres
;
Tcoupl  = V-rescale
tau_t   = 0.5
tc_grps = system
ref_t   = 300.0
;

Pcoupl     = C-rescale
pcoupltype = isotropic
tau_p = 2.0
ref_p = 1.01325
compressibility = 8.5e-5
;
gen_vel  = no
gen_temp = 300.0
gen_seed = -1
;
freezegrps  =
freezedim   =
constraints = hbonds
